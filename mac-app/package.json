{
  "name": "claude-heartbeat-mac",
  "productName": "Claude Heartbeat",
  "version": "1.0.0",
  "description": "Claude Heartbeat — macOS menu bar push-to-talk app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.claudeheartbeat.app",
    "productName": "Claude Heartbeat",
    "copyright": "MIT",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "Claude Heartbeat",
      "backgroundColor": "#1a1a1a",
      "window": { "width": 540, "height": 380 }
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    }
  }
}
